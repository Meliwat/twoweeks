[0.410, "o", "  Here's the plan:\r\n"]
[0.507, "o", "\r\n"]
[0.208, "o", "    Weeks 1-2: data model, streaks, basic CRUD\r\n"]
[0.556, "o", "    Weeks 3-4: push notifications via FCM/APNs\r\n"]
[0.561, "o", "    Weeks 5-6: leaderboard with ranked queries\r\n"]
