{
  "name": "twoweeks",
  "version": "0.7.1",
  "description": "Why your AI assistant always says two weeks but you ship by lunch.",
  "author": "meliwat",
  "license": "MIT",
  "type": "module",
  "bin": {
    "twoweeks": "./dist/cli.js"
  },
  "scripts": {
    "cli": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=node --packages=external --outfile=dist/cli.js && chmod +x dist/cli.js",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test",
    "start": "bun run src/cli.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "claude",
    "chatgpt",
    "copilot",
    "cursor",
    "estimate",
    "estimation",
    "cli",
    "developer-tools",
    "productivity",
    "time-tracker",
    "humor",
    "brag",
    "shipping",
    "open-graph",
    "screenshot",
    "claude-code",
    "claude-code-hook",
    "hook",
    "auto-capture"
  ],
  "homepage": "https://github.com/Meliwat/twoweeks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meliwat/twoweeks.git"
  },
  "bugs": {
    "url": "https://github.com/Meliwat/twoweeks/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0"
  }
}
