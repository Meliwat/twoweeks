{
  "name": "twoweeks",
  "version": "0.2.0",
  "description": "Why your AI assistant always says two weeks but you ship by lunch.",
  "author": "meliwat",
  "license": "MIT",
  "type": "module",
  "bin": {
    "twoweeks": "./dist/cli.js"
  },
  "scripts": {
    "cli": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js && chmod +x dist/cli.js",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test",
    "start": "bun run src/cli.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "claude",
    "chatgpt",
    "estimate",
    "cli",
    "joke",
    "productivity",
    "bun",
    "time-tracker"
  ],
  "homepage": "https://github.com/Meliwat/twoweeks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meliwat/twoweeks.git"
  },
  "bugs": {
    "url": "https://github.com/Meliwat/twoweeks/issues"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
